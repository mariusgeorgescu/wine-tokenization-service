[Unit]
Description=Wine Project (Docker Compose stack)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# IMPORTANT: Set to the absolute path on the target Linux host where the repo lives
WorkingDirectory=/opt/wine-project
Environment=COMPOSE_PROJECT_NAME=wine-project

ExecStart=/usr/bin/docker compose up -d
ExecReload=/usr/bin/docker compose pull && /usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
RemainAfterExit=yes
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target


